---
import Layout from '../layouts/Layout.astro';

const GITHUB_USER = 'simo899t';
const socials = [
  { label: 'GitHub', href: `https://github.com/${GITHUB_USER}` },
  { label: 'IMADA Fagråd', href: 'https://imadafagraad.dk' },
  { label: 'CV', href: '/cv' },
];
---

<Layout title="Simon Holm" description="AI student at SDU. Chairperson of IMADA Fagråd.">
  <div class="container page">

    <div class="layout">
      <div class="content">
        <p class="eyebrow">AI &amp; Computer Science · SDU Odense</p>
        <h1><strong>Simon</strong> Holm</h1>

        <p>
          AI student at SDU, passionate about machine learning with a key interest in
          mechanistic interpretability and Danish and European AI/technology sovereignty.
        </p>
        <p>
          I chair the <a href="https://imadafagraad.dk" target="_blank">IMADA Fagråd</a>, the
          student council for the institute of math &amp; computer science at my university.
          Outside that: math, science-fiction, music, gaming.
        </p>
        <p>
          I write my study notes and assignments in <a href="https://typst.app" target="_blank">Typst</a>.
          See <a href="/notes">how I do it</a>, browse <a href="/coursework">all my coursework</a>,
          or play my browser game <a href="/typstnique">Typstnique</a>.
        </p>
      </div>

      <aside class="sidebar">
        <div class="photo-ring">
          <img src="/profile.png" alt="Simon Holm" class="photo" />
        </div>
        <p class="address">Institute of Mathematics<br />and Computer Science, SDU<br />Odense, Denmark</p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a>
          ))}
        </div>
      </aside>
    </div>

    <section class="contrib" id="contrib" data-user={GITHUB_USER}>
      <div class="contrib-head">
        <h2>GitHub activity</h2>
        <span class="contrib-total" id="contrib-total">loading…</span>
      </div>
      <div class="contrib-scroll" id="contrib-scroll">
        <div class="contrib-grid" id="contrib-grid"></div>
      </div>
      <div class="contrib-legend" id="contrib-legend" hidden>
        <span>Less</span>
        <i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>
        <span>More</span>
      </div>
      <p class="contrib-fallback" id="contrib-fallback" hidden>
        <a href={`https://github.com/${GITHUB_USER}`} target="_blank" rel="noopener">View activity on GitHub →</a>
      </p>
    </section>

  </div>
</Layout>

<style>
.layout {
  display: grid;
  grid-template-columns: 1fr 200px;
  gap: 3rem;
  align-items: start;
  padding-top: 1.5rem;
}

.eyebrow {
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 0.9rem;
}

h1 {
  font-family: var(--font-serif);
  font-size: 2.15rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin-bottom: 1.4rem;
  line-height: 1.1;
}
h1 strong { font-weight: 600; }

.content p {
  font-size: 0.925rem;
  margin-bottom: 1rem;
  color: var(--text-muted);
}

.sidebar {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;
  padding-top: 0.4rem;
}

.photo-ring { line-height: 0; }
.photo {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  object-fit: cover;
  display: block;
  border: 1px solid var(--border-2);
  filter: grayscale(0.15);
}

.address {
  font-size: 0.72rem;
  color: var(--text-dim);
  line-height: 1.75;
  margin: 0;
}

.socials {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 1rem;
}
.socials a {
  font-size: 0.76rem;
  color: var(--text-muted);
}
.socials a:hover { color: var(--text); }

/* GitHub contributions */
.contrib {
  margin-top: 3.5rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--rule);
}
.contrib-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.9rem;
}
.contrib-head h2 {
  font-size: 0.72rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-dim);
}
.contrib-total { font-size: 0.74rem; color: var(--text-muted); }
.contrib-fallback { font-size: 0.8rem; color: var(--text-muted); }

.contrib-scroll { overflow-x: auto; padding-bottom: 0.3rem; }
.contrib-grid {
  display: grid;
  grid-auto-flow: column;
  grid-template-rows: repeat(7, 10px);
  grid-auto-columns: 10px;
  gap: 2px;
  min-width: max-content;
}
.contrib-grid i,
.contrib-legend i {
  width: 10px;
  height: 10px;
  border-radius: 1px;
  background: var(--bg-2);
  border: 1px solid var(--border);
}
.contrib-grid i[data-level="1"], .contrib-legend i[data-level="1"] { background: rgba(var(--accent-rgb), 0.28); border-color: transparent; }
.contrib-grid i[data-level="2"], .contrib-legend i[data-level="2"] { background: rgba(var(--accent-rgb), 0.5);  border-color: transparent; }
.contrib-grid i[data-level="3"], .contrib-legend i[data-level="3"] { background: rgba(var(--accent-rgb), 0.74); border-color: transparent; }
.contrib-grid i[data-level="4"], .contrib-legend i[data-level="4"] { background: rgba(var(--accent-rgb), 1);    border-color: transparent; }

.contrib-legend {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-top: 0.8rem;
  font-size: 0.68rem;
  color: var(--text-dim);
}
.contrib-legend span { margin: 0 0.4rem; }

@media (max-width: 560px) {
  .layout { grid-template-columns: 1fr; gap: 2rem; }
  .sidebar { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .photo { width: 76px; height: 76px; }
}
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('contrib');
    if (!el) return;
    var user = el.dataset.user;
    var grid = document.getElementById('contrib-grid');
    var totalEl = document.getElementById('contrib-total');
    var scroll = document.getElementById('contrib-scroll');
    var legend = document.getElementById('contrib-legend');
    var fallback = document.getElementById('contrib-fallback');

    function fail() {
      if (totalEl) totalEl.textContent = '';
      if (scroll) scroll.hidden = true;
      if (fallback) fallback.hidden = false;
    }

    function render(days) {
      var firstDow = new Date(days[0].date + 'T00:00:00').getDay();
      var frag = document.createDocumentFragment();
      for (var i = 0; i < firstDow; i++) {
        var pad = document.createElement('i');
        pad.style.visibility = 'hidden';
        frag.appendChild(pad);
      }
      var total = 0;
      days.forEach(function (d) {
        total += d.count || 0;
        var cell = document.createElement('i');
        cell.setAttribute('data-level', String(d.level || 0));
        cell.title = d.count + ' on ' + d.date;
        frag.appendChild(cell);
      });
      grid.appendChild(frag);
      if (totalEl) totalEl.textContent = total.toLocaleString() + ' contributions in the last year';
      if (legend) legend.hidden = false;
    }

    function load(attempt) {
      fetch('https://github-contributions-api.jogruber.de/v4/' + user + '?y=last')
        .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
        .then(function (data) {
          var days = (data && data.contributions) || [];
          if (!days.length) throw new Error('empty');
          render(days);
        })
        .catch(function () {
          if (attempt < 2) { setTimeout(function () { load(attempt + 1); }, 1200); }
          else { fail(); }
        });
    }

    load(0);
  })();
</script>
